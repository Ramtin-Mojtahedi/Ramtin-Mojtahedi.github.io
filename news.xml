---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Ramtin Mojtahedi — Research and community news</title>
    <link>https://ramtin-mojtahedi.github.io/#news</link>
    <description>Selected public research updates and LinkedIn highlights from Ramtin Mojtahedi.</description>
    <language>en-ca</language>
    <lastBuildDate>{{ site.data.news.updated_at | date_to_rfc822 }}</lastBuildDate>
    <ttl>60</ttl>
    <atom:link href="https://ramtin-mojtahedi.github.io/news.xml" rel="self" type="application/rss+xml"/>
    {% for item in site.data.news.items %}
    <item>
      <title>{{ item.title | xml_escape }}</title>
      <link>{{ item.source_url | xml_escape }}</link>
      <guid isPermaLink="false">ramtin-news:{{ item.id | xml_escape }}</guid>
      <description>{{ item.summary | xml_escape }}</description>
      <category>{{ item.category | xml_escape }}</category>
      {% if item.date %}<pubDate>{{ item.date | date_to_rfc822 }}</pubDate>{% endif %}
    </item>
    {% endfor %}
  </channel>
</rss>
